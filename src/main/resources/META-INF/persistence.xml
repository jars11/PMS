<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Production demo unit: H2 file database (used by com.pms.Main). -->
    <persistence-unit name="pms" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.pms.entities.Habitacion</class>
        <class>com.pms.entities.Persona</class>
        <class>com.pms.entities.Pasajero</class>
        <class>com.pms.entities.TitularReserva</class>
        <class>com.pms.entities.Reserva</class>
        <class>com.pms.entities.RHPropuesta</class>
        <class>com.pms.entities.Pago</class>
        <class>com.pms.entities.Solicitud</class>
        <class>com.pms.entities.RHSolicitada</class>
        <class>com.pms.entities.ContratoReserva</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/pms"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>

    <!-- Test unit: in-memory H2, schema recreated per run (used by JUnit 5 tests). -->
    <persistence-unit name="pms-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.pms.entities.Habitacion</class>
        <class>com.pms.entities.Persona</class>
        <class>com.pms.entities.Pasajero</class>
        <class>com.pms.entities.TitularReserva</class>
        <class>com.pms.entities.Reserva</class>
        <class>com.pms.entities.RHPropuesta</class>
        <class>com.pms.entities.Pago</class>
        <class>com.pms.entities.Solicitud</class>
        <class>com.pms.entities.RHSolicitada</class>
        <class>com.pms.entities.ContratoReserva</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:pms_test;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>